{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    { "source": "/api/:path*", "destination": "https://remo-attendance-backend.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://remo-attendance-backend.onrender.com/sanctum/:path*" },
    { "source": "/auth/:path*", "destination": "https://remo-attendance-backend.onrender.com/auth/:path*" },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
